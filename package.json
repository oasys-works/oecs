		"test:oracle": "vitest run --config bench/net-oracle/vitest.config.ts",
		"verify": "pnpm typecheck && vitest run && pnpm build",
		"bench": "vitest bench",
		"prepublishOnly": "pnpm verify"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oasys-works/oecs.git"
	},
